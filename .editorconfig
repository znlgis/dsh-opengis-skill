# Editor defaults for the repository. Mirrors the LF normalization in
# .gitattributes; editors that support EditorConfig apply these automatically.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,mjs}]
indent_style = tab

[*.{json,jsonc,yaml,yml,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
